---
// Renders headline lines, one block per line (house rule: break after , or .).
// Each line is wrapped so headlines can slide up line by line when they scroll into view.
interface Props { lines: string[] }
const { lines } = Astro.props;
---
{lines.map((l, i) => <span class="l" style={`--li:${i}`}><span>{l}</span></span>)}
